# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/datasutra

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Upload Configuration
MAX_FILE_SIZE_MB=25

# Backend only. Never put these in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
AI_TIMEOUT_MS=25000

# Only the vector store runs in Docker; API and MongoDB remain as configured.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=datasutra_embeddings

# Google Web application OAuth client ID (same value in frontend and backend).
GOOGLE_CLIENT_ID=
